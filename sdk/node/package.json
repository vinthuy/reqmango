{
  "name": "@reqmango/sdk",
  "version": "0.1.0",
  "description": "Node.js SDK for the reqmango project management API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
