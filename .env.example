# Copy to .env then: docker compose up --build
# App: http://localhost  demo@example.com / demo1234

# Demo data (sample workspace/projects/issues + the demo logins above).
# ON for trying Reqmango out, OFF for anything reachable from the internet:
# these accounts have published passwords and would hand out an admin session.
# With SEED_DEMO=false a bootstrap superuser is created instead (see below).
SEED_DEMO=true

# Test fixtures (qa_tester@reqmango.com, QA workspace/project). CI only.
SEED_E2E=false

# First superuser, only created when the database has no superuser and
# SEED_DEMO=false. Leave ADMIN_PASSWORD empty to get a random password printed
# once in the backend log.
ADMIN_EMAIL=admin@reqmango.com
ADMIN_PASSWORD=

# Database
DB_USER=reqmango
DB_PASSWORD=reqmango
DB_NAME=reqmango
DB_PORT=5432

# Backend
# Generate a strong value: openssl rand -hex 32
SECRET_KEY=
API_PORT=8000
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEBUG=true

# GORM log level: silent|error|warn (default if DEBUG=false) or info (default if
# DEBUG=true). INFO logs every SQL statement with parameters; set to warn for
# production or long E2E runs where the full SQL output would be noisy and could
# persist user data.
DB_LOG_LEVEL=warn

# Requests slower than this are logged with a [SLOW] prefix. 0 disables the
# slow-request log; /health and /readyz are never logged.
SLOW_REQUEST_MS=1000

# Frontend
WEB_PORT=80

# AI (optional)
AI_API_KEY=
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com/v1
